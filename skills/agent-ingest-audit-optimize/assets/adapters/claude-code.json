{
  "adapter_version": 1,
  "client": "claude-code",
  "expires_on": "2026-10-28",
  "anchors": {
    "$USER_CONFIG": ["$env:CLAUDE_CONFIG_DIR", "~/.claude"],
    "$HOME": ["~"],
    "$PROJECT": ["."]
  },
  "probes": [
    { "kind": "instruction-file", "scope": "user", "glob": "$USER_CONFIG/CLAUDE.md" },
    { "kind": "instruction-file", "scope": "user", "glob": "$USER_CONFIG/rules/*.md" },
    { "kind": "skill", "scope": "user", "glob": "$USER_CONFIG/skills/*/SKILL.md" },
    { "kind": "agent", "scope": "user", "glob": "$USER_CONFIG/agents/*" },
    { "kind": "command", "scope": "user", "glob": "$USER_CONFIG/commands/*" },
    { "kind": "model-setting", "scope": "user", "path": "$USER_CONFIG/settings.json" },
    { "kind": "permission-rule", "scope": "user", "path": "$USER_CONFIG/settings.json",
      "parse": "json", "pointer": "/permissions" },
    { "kind": "hook", "scope": "user", "path": "$USER_CONFIG/settings.json",
      "parse": "json", "pointer": "/hooks" },
    { "kind": "env-var-name", "scope": "user", "path": "$USER_CONFIG/settings.json",
      "parse": "json", "pointer": "/env" },
    { "kind": "model-setting", "scope": "user", "path": "$USER_CONFIG/settings.local.json" },
    { "kind": "permission-rule", "scope": "user", "path": "$USER_CONFIG/settings.local.json",
      "parse": "json", "pointer": "/permissions" },
    { "kind": "hook", "scope": "user", "path": "$USER_CONFIG/settings.local.json",
      "parse": "json", "pointer": "/hooks" },
    { "kind": "env-var-name", "scope": "user", "path": "$USER_CONFIG/settings.local.json",
      "parse": "json", "pointer": "/env" },
    { "kind": "plugin", "scope": "user", "path": "$USER_CONFIG/plugins/installed_plugins.json",
      "parse": "json" },
    { "kind": "plugin", "scope": "user", "path": "$USER_CONFIG/plugins/known_marketplaces.json",
      "parse": "json" },
    { "kind": "mcp-server", "scope": "user", "path": "$HOME/.claude.json",
      "parse": "json", "pointer": "/mcpServers" },
    { "kind": "instruction-file", "scope": "project", "glob": "$PROJECT/CLAUDE.md" },
    { "kind": "instruction-file", "scope": "project", "glob": "$PROJECT/.claude/CLAUDE.md" },
    { "kind": "instruction-file", "scope": "project", "glob": "$PROJECT/CLAUDE.local.md" },
    { "kind": "instruction-file", "scope": "project", "glob": "$PROJECT/.claude/rules/**/*.md" },
    { "kind": "model-setting", "scope": "project", "path": "$PROJECT/.claude/settings.json" },
    { "kind": "permission-rule", "scope": "project", "path": "$PROJECT/.claude/settings.json",
      "parse": "json", "pointer": "/permissions" },
    { "kind": "hook", "scope": "project", "path": "$PROJECT/.claude/settings.json",
      "parse": "json", "pointer": "/hooks" },
    { "kind": "env-var-name", "scope": "project", "path": "$PROJECT/.claude/settings.json",
      "parse": "json", "pointer": "/env" },
    { "kind": "model-setting", "scope": "project", "path": "$PROJECT/.claude/settings.local.json" },
    { "kind": "permission-rule", "scope": "project", "path": "$PROJECT/.claude/settings.local.json",
      "parse": "json", "pointer": "/permissions" },
    { "kind": "hook", "scope": "project", "path": "$PROJECT/.claude/settings.local.json",
      "parse": "json", "pointer": "/hooks" },
    { "kind": "env-var-name", "scope": "project", "path": "$PROJECT/.claude/settings.local.json",
      "parse": "json", "pointer": "/env" },
    { "kind": "mcp-server", "scope": "project", "path": "$PROJECT/.mcp.json",
      "parse": "json", "pointer": "/mcpServers" }
  ],
  "sensitive_key_patterns": ["*token*", "*key*", "*secret*", "*password*", "*credential*", "*auth*", "env", "headers", "args", "*url*"]
}
