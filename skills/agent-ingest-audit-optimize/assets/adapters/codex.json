{
  "adapter_version": 2,
  "client": "codex",
  "expires_on": "2027-02-17",
  "anchors": {
    "$USER_CONFIG": [
      "$env:CODEX_HOME",
      "~/.codex"
    ],
    "$HOME": [
      "~"
    ],
    "$PROJECT": [
      "."
    ],
    "$SYSTEM_CONFIG": [
      "$platform:linux:/etc/codex",
      "$platform:darwin:/etc/codex",
      "$platform:win32:C:/ProgramData/OpenAI/Codex"
    ]
  },
  "probes": [
    {
      "kind": "model-setting",
      "scope": "user",
      "path": "$USER_CONFIG/config.toml",
      "parse": "toml"
    },
    {
      "kind": "mcp-server",
      "scope": "user",
      "path": "$USER_CONFIG/config.toml",
      "parse": "toml",
      "pointer": "/mcp_servers",
      "lockable": true
    },
    {
      "kind": "plugin",
      "scope": "user",
      "path": "$USER_CONFIG/config.toml",
      "parse": "toml",
      "pointer": "/plugins",
      "lockable": true
    },
    {
      "kind": "model-setting",
      "scope": "user",
      "glob": "$USER_CONFIG/*.config.toml"
    },
    {
      "kind": "instruction-file",
      "scope": "user",
      "glob": "$USER_CONFIG/AGENTS.md"
    },
    {
      "kind": "instruction-file",
      "scope": "user",
      "glob": "$USER_CONFIG/AGENTS.override.md"
    },
    {
      "kind": "skill",
      "scope": "user",
      "glob": "$HOME/.agents/skills/*/SKILL.md",
      "lockable": true
    },
    {
      "kind": "skill",
      "scope": "user",
      "glob": "$USER_CONFIG/skills/*/SKILL.md",
      "lockable": true
    },
    {
      "kind": "hook",
      "scope": "user",
      "path": "$USER_CONFIG/hooks.json",
      "lockable": true
    },
    {
      "kind": "permission-rule",
      "scope": "user",
      "glob": "$USER_CONFIG/rules/*.rules"
    },
    {
      "kind": "agent",
      "scope": "user",
      "glob": "$USER_CONFIG/agents/*.toml",
      "lockable": true
    },
    {
      "kind": "model-setting",
      "scope": "project",
      "path": "$PROJECT/.codex/config.toml",
      "parse": "toml"
    },
    {
      "kind": "mcp-server",
      "scope": "project",
      "path": "$PROJECT/.codex/config.toml",
      "parse": "toml",
      "pointer": "/mcp_servers",
      "lockable": true
    },
    {
      "kind": "plugin",
      "scope": "project",
      "path": "$PROJECT/.codex/config.toml",
      "parse": "toml",
      "pointer": "/plugins",
      "lockable": true
    },
    {
      "kind": "instruction-file",
      "scope": "project",
      "glob": "$PROJECT/AGENTS.md"
    },
    {
      "kind": "instruction-file",
      "scope": "project",
      "glob": "$PROJECT/AGENTS.override.md"
    },
    {
      "kind": "skill",
      "scope": "project",
      "glob": "$PROJECT/.agents/skills/*/SKILL.md",
      "lockable": true
    },
    {
      "kind": "hook",
      "scope": "project",
      "path": "$PROJECT/.codex/hooks.json",
      "lockable": true
    },
    {
      "kind": "permission-rule",
      "scope": "project",
      "glob": "$PROJECT/.codex/rules/*.rules"
    },
    {
      "kind": "agent",
      "scope": "project",
      "glob": "$PROJECT/.codex/agents/*.toml",
      "lockable": true
    },
    {
      "kind": "model-setting",
      "scope": "system",
      "path": "$SYSTEM_CONFIG/config.toml",
      "parse": "toml"
    },
    {
      "kind": "skill",
      "scope": "system",
      "glob": "$SYSTEM_CONFIG/skills/*/SKILL.md",
      "lockable": true
    },
    {
      "kind": "hook",
      "scope": "system",
      "path": "$SYSTEM_CONFIG/hooks.json",
      "lockable": true
    },
    {
      "kind": "permission-rule",
      "scope": "managed",
      "path": "$SYSTEM_CONFIG/requirements.toml"
    }
  ],
  "sensitive_key_patterns": [
    "*token*",
    "*key*",
    "*secret*",
    "*password*",
    "*credential*",
    "*auth*",
    "env",
    "headers",
    "set",
    "projects",
    "args",
    "*url*"
  ],
  "resolution": {
    "skill": {
      "mode": "merge"
    },
    "instruction-file": {
      "mode": "concatenate"
    },
    "model-setting": {
      "mode": "key-override",
      "order": [
        "project",
        "user",
        "system"
      ]
    }
  }
}
